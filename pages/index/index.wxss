/* pages/index/index.wxss */
.header {
  margin-top: 20rpx;
}

.greeting {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.daily-status {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 0;
}

.status-item {
  text-align: center;
}

.status-item .value {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A90E2;
}

.status-item .label {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
}

.start-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.start-btn {
  width: 400rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 36rpx;
}

.plan-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 30rpx;
}

/* 智能推荐卡片 */
.reco-card {
  border-left: 8rpx solid var(--color-accent, #4A90E2);
  padding: 30rpx;
}

.reco-head {
  display: flex;
  align-items: center;
}

.reco-badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--color-accent, #4A90E2);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.reco-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1d1d1f;
}

.reco-reason {
  font-size: 24rpx;
  color: #666;
  margin-top: 16rpx;
  line-height: 1.5;
}

.reco-plan {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}

.reco-plan-name {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--color-accent, #4A90E2);
}

.reco-plan-meta {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

.reco-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.5;
}

.reco-btn {
  margin-top: 24rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 0;
  font-size: 28rpx;
}

/* 推荐类型配色 */
.reco-upgrade {
  border-left-color: #4A90E2;
}
.reco-upgrade .reco-badge {
  background: #4A90E2;
}

.reco-maintain {
  border-left-color: #52C41A;
}
.reco-maintain .reco-badge {
  background: #52C41A;
}

.reco-consolidate {
  border-left-color: #FA8C16;
}
.reco-consolidate .reco-badge {
  background: #FA8C16;
}

.reco-start {
  border-left-color: #9C6ADE;
}
.reco-start .reco-badge {
  background: #9C6ADE;
}



/* --- Animations --- */

/* 1. Page Entry Cascade Animation */
@keyframes fadeSlideUp {
  0% { transform: translateY(40rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}
.anim-cascade-1 { animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both; animation-delay: 0ms; }
.anim-cascade-2 { animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both; animation-delay: 100ms; }
.anim-cascade-3 { animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both; animation-delay: 200ms; }
.anim-cascade-4 { animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both; animation-delay: 300ms; }

/* 2. Stats Counter Animation */
@keyframes popIn {
  0% { transform: scale(0.5); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.anim-pop { 
  display: inline-block; /* Ensure transform applies */
  animation: popIn 600ms cubic-bezier(0.175, 0.885, 0.32, 1.275) both; 
  animation-delay: 400ms; 
}

/* 3. Start Button Premium Animation */
@keyframes pulseGlow {
  0% { box-shadow: 0 0 0 0 rgba(74, 144, 226, 0.4); }
  70% { box-shadow: 0 0 0 20rpx rgba(74, 144, 226, 0); }
  100% { box-shadow: 0 0 0 0 rgba(74, 144, 226, 0); }
}
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}
.anim-start-btn {
  background: linear-gradient(90deg, #4A90E2 0%, #6AB0FF 25%, #4A90E2 50%);
  background-size: 200% 100%;
  animation: shimmer 3s infinite linear, pulseGlow 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
  transition: transform 150ms ease-out;
}
.anim-start-btn:active {
  transform: scale(0.95);
}

/* 4. Recommendation Card Animation */
@keyframes borderGlow {
  0% { box-shadow: -6rpx 0 12rpx -4rpx rgba(0,0,0,0.1); }
  50% { box-shadow: -6rpx 0 20rpx -2rpx var(--color-accent, rgba(74, 144, 226, 0.5)); }
  100% { box-shadow: -6rpx 0 12rpx -4rpx rgba(0,0,0,0.1); }
}
.anim-reco-card {
  animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both 200ms, borderGlow 3s infinite ease-in-out 800ms;
}
.anim-reco-btn {
  background: linear-gradient(90deg, #4A90E2 0%, #5ba0f2 25%, #4A90E2 50%);
  background-size: 200% 100%;
  animation: shimmer 4s infinite linear;
  transition: transform 150ms ease-out;
}
.anim-reco-btn:active {
  transform: scale(0.95);
}

/* 5. Greeting Animation */
@keyframes letterSpacingReveal {
  0% { letter-spacing: -0.2em; opacity: 0; }
  100% { letter-spacing: normal; opacity: 1; }
}
.anim-greeting {
  animation: letterSpacingReveal 800ms cubic-bezier(0.4, 0, 0.2, 1) both 100ms;
}
.anim-subtitle {
  animation: popIn 600ms cubic-bezier(0.4, 0, 0.2, 1) both 400ms;
}

/* 6. Floating Background Element */
.bg-orb {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(74,144,226,0.12) 0%, rgba(74,144,226,0) 70%);
  animation: floatOrb 10s infinite alternate ease-in-out;
  z-index: -1;
  pointer-events: none;
}
@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(-40rpx, 60rpx) scale(1.1); }
}
