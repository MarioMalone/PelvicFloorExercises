/* pages/training/training.wxss — 浅色莫兰迪主题（方案 B） */

.training-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 38%, #ffffff 0%, var(--color-bg, #f7f7f7) 72%);
  position: relative;
  overflow: hidden;
}

.ring-canvas {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300px;
  height: 300px;
}

/* UI 覆盖层：文字叠在圆环中央 */
.ui-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}

.close-btn {
  position: absolute;
  top: 100rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: rgba(0, 0, 0, 0.25);
  font-size: 40rpx;
  pointer-events: auto;
  z-index: 100;
}

.stage-label {
  font-size: 26rpx;
  letter-spacing: 12rpx;
  margin-bottom: 14rpx;
  font-weight: 500;
  padding-left: 12rpx;
}
.stage-label.prepare { color: #9AA7B2; }
.stage-label.hold { color: #D65D56; }
.stage-label.relax { color: #4A90E2; }

.timer-display {
  font-size: 110rpx;
  font-weight: 200;
  color: var(--color-text, #1d1d1f);
  font-family: 'Helvetica Neue', 'Inter', sans-serif;
  line-height: 1;
}

.round-indicator {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.35);
  margin-top: 18rpx;
  letter-spacing: 4rpx;
}

.end-training-btn {
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 18rpx 56rpx;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 44rpx;
  background-color: #ffffff;
  color: rgba(0, 0, 0, 0.5);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  pointer-events: auto;
  transition: all 0.3s ease;
}

.end-training-btn:active {
  background-color: rgba(0, 0, 0, 0.04);
  color: rgba(0, 0, 0, 0.7);
  transform: translateX(-50%) scale(0.97);
}
