/* pages/training/training.wxss — 浅色莫兰迪主题（方案 B） */

.training-container {
  width: 100vw;
  height: 100vh;
  background: radial-gradient(circle at 50% 38%, #ffffff 0%, var(--color-bg, #f7f7f7) 72%);
  position: relative;
  overflow: hidden;
}

.ring-canvas {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 340px;
  height: 340px;
}

/* UI 覆盖层：文字叠在圆环中央 */
.ui-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}

.close-btn {
  position: absolute;
  top: 100rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: rgba(0, 0, 0, 0.25);
  font-size: 40rpx;
  pointer-events: auto;
  z-index: 100;
}



.timer-display {
  font-size: 116rpx;
  font-weight: 200;
  color: #1d1d1f;
  font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', 'Inter', sans-serif;
  line-height: 1;
  text-shadow: 0 2rpx 16rpx rgba(255, 255, 255, 0.85);
  letter-spacing: -2rpx;
}

.round-indicator {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.45);
  margin-top: 18rpx;
  letter-spacing: 4rpx;
  font-weight: 400;
}

.end-training-btn {
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 18rpx 56rpx;
  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 44rpx;
  background-color: #ffffff;
  color: rgba(0, 0, 0, 0.5);
  font-size: 26rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  pointer-events: auto;
  transition: all 0.3s ease;
}

.end-training-btn:active {
  background-color: rgba(0, 0, 0, 0.04);
  color: rgba(0, 0, 0, 0.7);
  transform: translateX(-50%) scale(0.97);
}

/* --- ANIMATIONS --- */

.ambient-glow::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(circle at 50% 38%, rgba(255,255,255,0.4) 0%, rgba(150, 180, 220, 0.15) 100%);
  z-index: -1;
  animation: ambientShift 6s infinite alternate ease-in-out;
}

@keyframes ambientShift {
  0% { opacity: 0.6; transform: scale(1); }
  100% { opacity: 1; transform: scale(1.1); }
}

.stage-label {
  animation: fadeScale 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 26rpx;
  letter-spacing: 12rpx;
  margin-bottom: 14rpx;
  font-weight: 500;
  padding-left: 12rpx;
}
.stage-label.prepare { color: #9AA7B2; }
.stage-label.hold { color: #D65D56; }
.stage-label.relax { color: #4A90E2; }

@keyframes fadeScale {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.pulse-tick {
  animation: tickPulse 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes tickPulse {
  0% { transform: scale(0.95); opacity: 0.8; }
  40% { transform: scale(1.03); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.slide-up {
  animation: slideUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes slideUp {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.floating-btn {
  animation: floatBreath 4s infinite ease-in-out;
}

@keyframes floatBreath {
  0% { transform: translateX(-50%) translateY(0); box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06); }
  50% { transform: translateX(-50%) translateY(-10rpx); box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12); }
  100% { transform: translateX(-50%) translateY(0); box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06); }
}

.close-btn-hover {
  transform: scale(0.85) !important;
  opacity: 0.6 !important;
  transition: all 0.2s ease;
}
