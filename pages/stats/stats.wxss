/* pages/stats/stats.wxss */
.header-banner {
  padding: 40rpx 10rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #64B5F6 100%);
  margin: -30rpx -30rpx 30rpx -30rpx;
  padding: 60rpx 40rpx;
  color: white;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
}

.banner-desc {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 10rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
  position: relative;
  z-index: 10;
}

.grid-item {
  text-align: center;
  padding: 30rpx 10rpx !important;
}

.grid-item .label {
  font-size: 22rpx;
  color: #999;
}

.grid-item .value {
  font-size: 40rpx;
  font-weight: bold;
  color: #4A90E2;
  margin-top: 10rpx;
}

.grid-item .unit {
  font-size: 20rpx;
  color: #999;
}

.calendar-card {
  padding: 30rpx !important;
}

.calendar-header {
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.calendar-day {
  height: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-number {
  font-size: 26rpx;
  color: #333;
}

.day-number.today {
  color: #4A90E2;
  font-weight: bold;
  border-bottom: 2rpx solid #4A90E2;
}

.training-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #EEE;
  margin-top: 6rpx;
}

.training-dot.active {
  background: #4A90E2;
  transform: scale(1.5);
  box-shadow: 0 0 8rpx rgba(74, 144, 226, 0.4);
}

.chart-container {
  padding: 40rpx 20rpx !important;
}

.chart-main {
  height: 200rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.chart-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-wrapper {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
}

.bar {
  width: 40rpx;
  background: linear-gradient(to top, #4A90E2, #64B5F6);
  border-radius: 20rpx 20rpx 0 0;
  position: relative;
  transition: height 0.3s ease-out;
}

.bar-value {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #4A90E2;
  font-weight: bold;
}

.bar-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 40rpx 0 20rpx 0;
  color: #333;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx !important;
}

.item-date {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.item-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.status-tag {
  font-size: 22rpx;
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

/* 成就卡：等级 + 勋章 */
.achievement-card {
  padding: 30rpx !important;
}

.achievement-head {
  display: flex;
  align-items: center;
}

.level-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90E2 0%, #64B5F6 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.level-info {
  flex: 1;
  margin-left: 24rpx;
}

.level-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.level-progress-track {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  margin: 14rpx 0 8rpx;
  overflow: hidden;
}

.level-progress-fill {
  height: 100%;
  background: linear-gradient(to right, #4A90E2, #64B5F6);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.level-hint {
  font-size: 22rpx;
  color: #999;
}

.badge-row {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.35;
  transition: opacity 0.2s ease;
}

.badge-item.unlocked {
  opacity: 1;
}

.badge-icon {
  font-size: 44rpx;
}

.badge-name {
  font-size: 20rpx;
  color: #666;
  margin-top: 6rpx;
}

/* =======================================================
   ANIMATIONS ENHANCEMENTS
   ======================================================= */

/* Page Entry Cascades */
@keyframes fadeSlideUp {
  0% { opacity: 0; transform: translateY(30rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes slideInRight {
  0% { opacity: 0; transform: translateX(50rpx); }
  100% { opacity: 1; transform: translateX(0); }
}

.achievement-card {
  animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 100ms;
}

.grid-item {
  animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both;
}

.calendar-card {
  animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 350ms;
}

.chart-container {
  animation: fadeSlideUp 600ms cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 450ms;
}

.history-item {
  animation: slideInRight 600ms cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* Banner Gradient Shift */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
.header-banner {
  background-size: 200% 200%;
  animation: gradientShift 6s ease-in-out infinite;
}

/* Level Badge: Bounce In + Rotating Border Glow */
@keyframes bounceIn {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes spinGlow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
.level-badge {
  position: relative;
  animation: bounceIn 600ms cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 200ms;
  z-index: 1;
}
.level-badge::before {
  content: '';
  position: absolute;
  top: -4rpx; left: -4rpx; right: -4rpx; bottom: -4rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, transparent 0%, transparent 40%, rgba(255, 255, 255, 0.8) 50%, transparent 60%, transparent 100%);
  animation: spinGlow 3s linear infinite;
  z-index: -1;
}

/* Progress Bar */
@keyframes fillProgress {
  0% { transform: scaleX(0); }
  100% { transform: scaleX(1); }
}
@keyframes shineSweep {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(200%); }
}
.level-progress-fill {
  transform-origin: left;
  animation: fillProgress 800ms cubic-bezier(0, 0, 0.2, 1) both;
  animation-delay: 300ms;
  position: relative;
  overflow: hidden;
}
.level-progress-fill::after {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 50%; height: 100%;
  background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);
  transform: translateX(-100%);
  animation: shineSweep 2.5s infinite;
  animation-delay: 1100ms;
}

/* Badge Row */
@keyframes popIn {
  0% { transform: scale(0); opacity: 0; }
  80% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes goldGlow {
  0%, 100% { box-shadow: 0 0 10rpx rgba(255, 215, 0, 0.3); }
  50% { box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6); }
}
.badge-item {
  animation: popIn 500ms cubic-bezier(0.4, 0, 0.2, 1) both;
}
.badge-item.unlocked .badge-icon {
  border-radius: 50%;
  animation: goldGlow 2s infinite ease-in-out;
}

/* Bar Chart */
@keyframes barGrow {
  0% { transform: scaleY(0); }
  80% { transform: scaleY(1.05); }
  100% { transform: scaleY(1); }
}
.bar {
  transform-origin: bottom;
  animation: barGrow 500ms cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* Calendar Day Dots & Today Glow */
@keyframes pulseDot {
  0%, 100% { transform: scale(1.5); box-shadow: 0 0 8rpx rgba(74, 144, 226, 0.4); }
  50% { transform: scale(2); box-shadow: 0 0 16rpx rgba(74, 144, 226, 0.8); }
}
.training-dot.active {
  animation: pulseDot 2s infinite ease-in-out;
}

@keyframes todayGlow {
  0%, 100% { text-shadow: 0 0 4rpx rgba(74, 144, 226, 0.2); }
  50% { text-shadow: 0 0 12rpx rgba(74, 144, 226, 0.6); }
}
.day-number.today {
  animation: todayGlow 2s infinite ease-in-out;
}

/* Summary Grid Numbers */
.grid-item .value {
  animation: popIn 500ms cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: inherit;
}

/* History Item Tag Shimmer */
@keyframes tagShimmer {
  0% { background-position: -100% 0; }
  100% { background-position: 200% 0; }
}
.status-tag {
  position: relative;
  overflow: hidden;
  background: linear-gradient(90deg, rgba(74, 144, 226, 0.1) 0%, rgba(74, 144, 226, 0.3) 50%, rgba(74, 144, 226, 0.1) 100%);
  background-size: 200% 100%;
  animation: tagShimmer 3s infinite linear;
}
