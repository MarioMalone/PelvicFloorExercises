<!-- pages/settings/settings.wxml -->
<view class="container">
  <view class="section-title anim-cascade-1">训练方案</view>
  <view class="card preset-card anim-cascade-1">
    <view class="preset-row">
      <view wx:for="{{presets}}" wx:key="key"
            class="preset-btn {{selectedPreset === item.key ? 'active anim-scale-in' : ''}}"
            data-key="{{item.key}}" bindtap="onPresetTap">
        <view class="preset-name">{{item.name}}</view>
        <view class="preset-desc">{{item.desc}}</view>
        <view class="active-check" wx:if="{{selectedPreset === item.key}}"></view>
      </view>
    </view>
  </view>

  <view class="section-title anim-cascade-2">训练参数设置</view>
  
  <view class="card settings-group anim-cascade-2">
    <view class="setting-item">
      <view class="item-label">
        <text class="title">收缩时长</text>
        <text class="desc">每次肌肉收缩持续的时间</text>
      </view>
      <view class="item-control">
        <slider bindchange="onHoldTimeChange" bindchanging="onHoldTimeChanging" value="{{holdTime}}" min="1" max="10" show-value activeColor="#4A90E2" />
        <text class="unit {{isHoldTimeChanging ? 'anim-bounce-in' : ''}}">秒</text>
      </view>
    </view>

    <view class="setting-item">
      <view class="item-label">
        <text class="title">放松时长</text>
        <text class="desc">每次肌肉放松持续的时间</text>
      </view>
      <view class="item-control">
        <slider bindchange="onRelaxTimeChange" bindchanging="onRelaxTimeChanging" value="{{relaxTime}}" min="1" max="10" show-value activeColor="#4A90E2" />
        <text class="unit {{isRelaxTimeChanging ? 'anim-bounce-in' : ''}}">秒</text>
      </view>
    </view>

    <view class="setting-item border-none">
      <view class="item-label">
        <text class="title">循环次数</text>
        <text class="desc">每组训练包含的循环数</text>
      </view>
      <view class="item-control">
        <slider bindchange="onRepeatsChange" bindchanging="onRepeatsChanging" value="{{repeats}}" min="1" max="30" show-value activeColor="#4A90E2" />
        <text class="unit {{isRepeatsChanging ? 'anim-bounce-in' : ''}}">次</text>
      </view>
    </view>
  </view>

  <view class="btn-primary anim-cascade-3 {{saveSuccess ? 'save-success' : ''}}" bindtap="saveSettings">
    <text wx:if="{{!saveSuccess}}">保存设置</text>
    <text wx:else>✓ 已保存</text>
  </view>

  <view class="section-title margin-top anim-cascade-4">训练偏好</view>
  <view class="card settings-group anim-cascade-4">
    <view class="setting-item border-none">
      <view class="item-label">
        <text class="title">语音引导</text>
        <text class="desc">收缩 / 放松时播放「收」「放」语音提示</text>
      </view>
      <view class="item-control switch-control {{voiceEnabled ? 'switch-active' : ''}}">
        <switch checked="{{voiceEnabled}}" bindchange="onVoiceToggle" color="#4A90E2" />
      </view>
    </view>
  </view>

  <view class="section-title margin-top anim-cascade-5">每日提醒</view>
  <view class="card settings-group anim-cascade-5">
    <view class="setting-item">
      <view class="item-label">
        <text class="title">开启训练提醒</text>
        <text class="desc">每天定时提醒您进行盆底肌训练</text>
      </view>
      <view class="item-control switch-control {{reminderEnabled ? 'switch-active' : ''}}">
        <switch checked="{{reminderEnabled}}" bindchange="onReminderToggle" color="#4A90E2" />
      </view>
    </view>
    
    <view class="setting-item border-none" wx:if="{{reminderEnabled}}">
      <view class="item-label">
        <text class="title">提醒时间</text>
      </view>
      <view class="item-control">
        <picker mode="time" value="{{reminderTime}}" bindchange="onReminderTimeChange">
          <view class="picker-value">{{reminderTime}}</view>
        </picker>
        <text class="unit">></text>
      </view>
    </view>

    <view class="reco-push-tip" wx:if="{{reminderEnabled}}">
      <text class="reco-push-text">已授权订阅消息。真实定时推送需配合云函数，点击下方按钮可立即发送一条测试推送验证可达性。</text>
      <view class="btn-secondary reco-push-btn" bindtap="sendTestReminder">发送测试提醒</view>
    </view>
  </view>

  <view class="section-title margin-top anim-cascade-6">关于</view>
  <view class="card settings-group anim-cascade-6">
    <view class="setting-item border-none" bindtap="goPrivacy">
      <view class="item-label">
        <text class="title">隐私保护指引</text>
      </view>
      <view class="item-control">
        <text class="unit">></text>
      </view>
    </view>
  </view>

  <view class="section-title margin-top anim-cascade-6">数据管理</view>
  <view class="card anim-cascade-6">
    <view class="danger-zone" bindtap="clearHistory">
      <text class="danger-text">清除所有训练历史</text>
      <text class="danger-arrow">></text>
    </view>
  </view>

  <view class="footer anim-fade-in" style="animation-delay: 800ms;">
    <text>版本 1.0.0</text>
  </view>
</view>